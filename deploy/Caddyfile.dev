# 开发环境反向代理 —— *.localhost 子域,不挂真实域名、无证书。
#
# 配套:docker-compose.yml 的 caddy 服务(监听宿主 ${CADDY_PORT:-80})。
# 浏览器自动把 *.localhost 解析到 127.0.0.1,无需改 /etc/hosts。
#
# 访问:
#   http://api.localhost      → api-server:8080
#   http://docs.localhost     → docs:3000
#   http://landing.localhost  → landing:80(推广页)
#   http://console.localhost  → web:3000(Cloud Console,主前端)
#   http://minio.localhost    → minio:9001(MinIO console)

{
	auto_https off
}

http://api.localhost {
	encode gzip
	reverse_proxy api-server:8080
}

http://docs.localhost {
	encode gzip
	reverse_proxy docs:3000
}

http://landing.localhost {
	encode gzip
	reverse_proxy landing:80
}

http://console.localhost {
	encode gzip
	reverse_proxy web:3000
}

http://minio.localhost {
	reverse_proxy minio:9001
}
