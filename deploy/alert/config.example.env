# ============================================================
# Combee 告警配置(部署在服务器 /opt/combee/deploy/alert/)
# 复制为 config.env 并填写:
#   cp config.example.env config.env && vim config.env
# ============================================================

# ---- 飞书 webhook(3 个群各一个机器人;创建方法见 README.md)----
# 运维告警群(P0/P1 紧急)
FEISHU_ALERT_WEBHOOK=
# 提醒群(P2 低优)
FEISHU_WARN_WEBHOOK=
# 日报群(每日汇总)
FEISHU_DAILY_WEBHOOK=

# ---- 监控的域名(证书过期检查)----
DOMAINS="combee.cloud api.combee.cloud docs.combee.cloud console.combee.cloud"

# ---- 阈值 ----
# 磁盘使用率(百分比)
DISK_WARN=85
DISK_CRIT=92
# 证书剩余天数
CERT_WARN=30
CERT_CRIT=7
# 5xx 错误率阈值(最近 5 分钟)
ERR5_P0=10
ERR5_P1=2
# CPU / 内存水位(百分比,docker stats)
RES_WARN=85
RES_CRIT=92

# ---- 告警冷却(分钟,同一项不重复轰炸)----
COOLDOWN_MIN=30

# ---- docker 相关 ----
# Swarm 栈名(online 部署)
STACK_NAME=combee
# 错误日志检索窗口(分钟)
LOG_WINDOW_MIN=5
