# Rust 构建产物
/target

# Docker 本地构建缓存(容器内 cargo build 的缓存目录)
/.docker-target

# 运行时数据(默认 COMBEE_DATA_DIR,SQLite 文件)
/data/

# 本地 benchmark 产物(运行 --capacity / --contention / --e2e 时重新生成)
# 只忽略自动生成的 benchmark 文件;artifacts/ 下的人工文件(指令、FACTS、工程文档)入库。
/artifacts/capacity.csv
/artifacts/capacity.md
/artifacts/capacity-inmemory.csv
/artifacts/capacity-inmemory.md
/artifacts/contention.csv
/artifacts/contention.md
/artifacts/e2e.csv
/artifacts/e2e.md

# 本地环境文件
.env
.env.*

# Reasonix 本地会话附件
/.reasonix/

# SDK 本地依赖与构建产物
/sdk/python/.venv/
/sdk/python/**/__pycache__/
/sdk/typescript/node_modules/
/sdk/typescript/dist/

# 独立 SDK 仓库(combee-js / combee-python,各自 git + GitHub 独立)
/combee-js/
/combee-python/
.gstack/

# macOS
.DS_Store

# pnpm 本地缓存(误提交过大对象,移除跟踪)
/.pnpm-store/
